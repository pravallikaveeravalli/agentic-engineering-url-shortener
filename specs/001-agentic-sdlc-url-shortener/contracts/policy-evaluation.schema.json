{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-sdlc-url-shortener/contracts/policy-evaluation.schema.json",
  "title": "PolicyEvaluation",
  "version": "1.1.0",
  "description": "Output of stage S10. Exactly four outcome values; an unevaluable check is never PASS (EC-025). A mandatory FAIL blocks downstream progression and release readiness.",
  "type": "object",
  "additionalProperties": false,
  "required": ["runId", "policySetVersion", "evaluatedAt", "results", "blocking"],
  "properties": {
    "runId": { "type": "string" },
    "policySetVersion": { "type": "string", "const": "policy-set-1.1.0" },
    "evaluatedAt": { "type": "string", "format": "date-time" },
    "blocking": {
      "type": "boolean",
      "description": "True when any mandatory result is FAIL, or an EXCEPTION_REQUESTED lacks recorded approval, or an approved exception has expired."
    },
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["policyId", "domain", "mandatory", "outcome", "reason"],
        "properties": {
          "policyId": {
            "type": "string",
            "enum": ["POL-SEC-001", "POL-SEC-002", "POL-SEC-003", "POL-PRIV-001",
                     "POL-AUD-001", "POL-DEP-001", "POL-LIC-001",
                     "POL-CHG-001", "POL-CHG-002", "POL-CHG-003", "POL-TST-001", "POL-TRC-001"]
          },
          "domain": {
            "type": "string",
            "enum": ["security", "compliance", "privacy", "audit_retention",
                     "approved_dependencies", "licensing", "change_control"]
          },
          "mandatory": { "type": "boolean" },
          "outcome": {
            "type": "string",
            "enum": ["PASS", "FAIL", "EXCEPTION_REQUESTED", "NOT_APPLICABLE"],
            "description": "Exactly four values. There is no UNKNOWN or SKIPPED — an unevaluable check is recorded FAIL, never PASS."
          },
          "reason": { "type": "string", "minLength": 1 },
          "exception": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "required": ["policyId", "clause", "reason", "scope", "approvingAuthority",
                         "compensatingControl", "residualRisk", "approvedAt", "expiresAt",
                         "repositoryRecordPath"],
            "properties": {
              "policyId": { "type": "string" },
              "clause": { "type": "string", "description": "The precise clause excepted, not the whole policy." },
              "reason": { "type": "string" },
              "scope": { "type": "string" },
              "approvingAuthority": { "type": "string" },
              "compensatingControl": { "type": "string" },
              "residualRisk": { "type": "string" },
              "approvedAt": { "type": "string", "format": "date-time" },
              "expiresAt": { "type": "string", "format": "date-time" },
              "repositoryRecordPath": {
                "type": "string",
                "pattern": "^docs/governance/exceptions/.+\\.md$"
              }
            },
            "description": "All seven constitutionally required fields plus materialization path. An unapproved or expired exception is a violation."
          }
        },
        "allOf": [
          {
            "description": "An EXCEPTION_REQUESTED outcome must carry its exception object; without recorded approval it is treated as FAIL.",
            "if": { "properties": { "outcome": { "const": "EXCEPTION_REQUESTED" } } },
            "then": { "properties": { "exception": { "type": "object" } } }
          }
        ]
      }
    },
    "releaseBlockingConditions": {
      "type": "array",
      "description": "The nine constitutional conditions, each evaluated. Named individually so a blocking report says which condition failed.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["conditionNumber", "description", "met"],
        "properties": {
          "conditionNumber": { "type": "integer", "minimum": 1, "maximum": 9 },
          "description": { "type": "string" },
          "met": { "type": "boolean" },
          "detail": { "type": ["string", "null"] }
        }
      }
    }
  }
}
